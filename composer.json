{
    "name": "kislayphp/queue",
    "description": "Native PHP distributed job queue with a standalone queue server, producer client, worker runtime, retries, and DLQ support",
    "type": "php-ext",
    "license": "Apache-2.0",
    "keywords": [
        "php",
        "microservices",
        "php-extension",
        "cpp-extension",
        "php-job-queue",
        "php-background-jobs",
        "distributed-job-queue",
        "dead-letter-queue",
        "delayed-jobs",
        "at-least-once-delivery",
        "php-async-processing"
    ],
    "homepage": "https://github.com/KislayPHP/queue",
    "authors": [
        {
            "name": "KislayPHP Team",
            "email": "team@kislayphp.com"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "scripts": {
        "lint": "php -n -l example.php",
        "validate-json": "php -n -r \"json_decode(file_get_contents('composer.json')); if (json_last_error()) { fwrite(STDERR, json_last_error_msg() . PHP_EOL); exit(1); } echo 'composer.json OK' . PHP_EOL;\""
    },
    "provide": {
        "ext-kislayphp_queue": "*"
    },
    "suggest": {
        "kislayphp/core": "HTTP/HTTPS server integration",
        "kislayphp/eventbus": "Real-time job notifications",
        "kislayphp/config": "Configurable queue settings",
        "kislayphp/discovery": "Service-aware job routing",
        "kislayphp/gateway": "Queue-aware API gateway",
        "kislayphp/metrics": "Queue performance metrics"
    },
    "support": {
        "issues": "https://github.com/KislayPHP/queue/issues",
        "source": "https://github.com/KislayPHP/queue",
        "docs": "https://github.com/KislayPHP/queue/blob/main/README.md"
    },
    "php-ext": {
        "extension-name": "kislayphp_queue",
        "configure-options": []
    }
}
